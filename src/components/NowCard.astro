---
import now from '../../data/now.json';
---

<div class="now-card">
  <h2 class="now-heading">Now <span class="now-hint">(updated {now.updated})</span></h2>
  <div class="now-grid">
    {now.items.map((item) => (
      <>
        <span class="now-label">{item.label}</span>
        <span class="now-sep">—</span>
        <span class="now-value">{item.value}</span>
      </>
    ))}
  </div>
</div>
