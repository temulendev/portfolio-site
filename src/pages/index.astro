---
import BaseLayout from '../layouts/BaseLayout.astro';
import MainCard from '../components/MainCard.astro';
import ProfileBlock from '../components/ProfileBlock.astro';
import SkillsCarousel from '../components/SkillsCarousel.astro';
import MusicPlayer from '../components/MusicPlayer.astro';
import NowCard from '../components/NowCard.astro';
---

<BaseLayout
  title="Temulen Iveelt"
  description="Temulen Iveelt — Computer Science & Business at Lehigh University. Co-Founder at CribCub."
  canonical="https://temuleniveelt.com/"
  includeLandingScripts={true}
>
  <script type="application/ld+json" slot="head" is:inline>
    {"@context":"https://schema.org","@type":"Person","name":"Temulen Iveelt","url":"https://temuleniveelt.com/"}
  </script>

  <audio id="audio" src="/angelIns.mp3" preload="metadata"></audio>

  <main class="container">
    <div class="sidebar-lead">
      <ProfileBlock />
      <SkillsCarousel />
    </div>
    <MainCard />
    <div class="sidebar-tail">
      <MusicPlayer />
      <NowCard />
    </div>
  </main>

  <footer class="site-footer">Website by Temulen Iveelt | 2026</footer>
</BaseLayout>
