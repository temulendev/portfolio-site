---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  description: string;
  canonical: string;
  ogType?: string;
  backHref?: string;
  backLabel?: string;
}

const {
  title,
  description,
  canonical,
  ogType = 'website',
  backHref = '/blog/',
  backLabel = '← Blog',
} = Astro.props;
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  ogType={ogType}
  ogImage={undefined}
  extraHead={'<link rel="stylesheet" href="/blog/blog.css" />'}
>
  <slot name="head" slot="head" />
  <a class="blog-back" href={backHref} slot="before-chrome">{backLabel}</a>

  <main class="blog-page">
    <slot />
  </main>
</BaseLayout>
